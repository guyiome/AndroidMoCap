<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
         Thème du système (fenêtre Android), utilisé avant même que Compose ne prenne le relais,
         pendant l'écran de démarrage et le temps de chargement de MediaPipe. Fond sombre pour
         éviter le flash blanc agressif au lancement, cohérent avec AndroidMoCapTheme (Theme.kt).
    -->
    <style name="Theme.AndroidMoCap" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
    </style>
</resources>
