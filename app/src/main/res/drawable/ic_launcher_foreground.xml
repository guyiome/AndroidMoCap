<?xml version="1.0" encoding="utf-8"?>
<!--
     Placeholder (9 août 2026), en attendant un logo dessiné par un.e artiste : image fournie par
     l'utilisateur (drawable-nodpi/ic_launcher_foreground_source.png), remplace le simple visage
     vectoriel dessiné à la main précédent. Marge de 12% sur chaque bord (inset) pour rester dans la
     zone sûre des icônes adaptatives (~66% du canevas garantis visibles quel que soit le masque de
     découpe (cercle, squircle...) appliqué par le launcher), évite que les oreilles/cheveux se
     retrouvent coupés sur certains lanceurs.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground_source"
    android:insetLeft="12%"
    android:insetTop="12%"
    android:insetRight="12%"
    android:insetBottom="12%" />
