<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Caméra frontale : capture du visage -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <!-- ARCore : utilisé seulement si disponible (palier "optimal"/"standard"), jamais bloquant -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <!-- Envoi des données de tracking en OSC/UDP (protocole VMC) sur le réseau local -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
         Visibilité de package (Android 11+, API 30+) pour com.google.ar.core, recommandée par la
         doc officielle ARCore pour fiabiliser ArCoreApk.checkAvailability()/Session() sous les
         restrictions de visibilité de packages. Sans impact aujourd'hui : le repli sur CameraX est
         déjà silencieux dans tous les cas (voir ArCoreHeadPoseTracker.onUnavailable), c'est un
         correctif défensif. Voir revue technique, point 13 (risque 3) et point 33.
    -->
    <queries>
        <package android:name="com.google.ar.core" />
    </queries>

    <application
        android:name=".MoCapApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AndroidMoCap">

        <!--
             ARCore "optional" : l'app reste installable et fonctionnelle sur les appareils
             qui n'ont pas Google Play Services for AR, conformément au pipeline adaptatif par paliers.
        -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Sélecteur de langue en-app (point 30) : persiste automatiquement la langue choisie via
             AppCompatDelegate.setApplicationLocales() sur TOUTES les versions d'Android (stockage
             propre à AppCompat sous API 33, délégué à LocaleManager au-delà), sans ce service, il
             faudrait réappliquer la langue nous-mêmes à chaque lancement (DataStore + appel manuel
             dans MainActivity.onCreate avant setContent). Ce service n'est jamais instancié
             (enabled=false), il ne sert qu'à déclarer la métadonnée que la bibliothèque AppCompat
             lit au démarrage.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
