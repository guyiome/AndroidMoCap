<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Caméra frontale : capture du visage -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <!-- ARCore : utilisé seulement si disponible (palier "optimal"/"standard"), jamais bloquant -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <!-- Envoi des données de tracking en OSC/UDP (protocole VMC) sur le réseau local -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
         Visibilité de package (Android 11+, API 30+) pour com.google.ar.core, recommandée par la
         doc officielle ARCore pour fiabiliser ArCoreApk.checkAvailability()/Session() sous les
         restrictions de visibilité de packages. Sans impact aujourd'hui : le repli sur CameraX est
         déjà silencieux dans tous les cas (voir ArCoreHeadPoseTracker.onUnavailable), c'est un
         correctif défensif.
    -->
    <queries>
        <package android:name="com.google.ar.core" />
    </queries>

    <application
        android:name=".MoCapApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AndroidMoCap">

        <!--
             ARCore "optional" : l'app reste installable et fonctionnelle sur les appareils
             qui n'ont pas Google Play Services for AR, conformément au pipeline adaptatif par paliers.
        -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!--
             Télémétrie MediaPipe neutralisée. `com.google.mediapipe:tasks-vision` embarque
             `com.google.android.datatransport`, qui enregistre ici un backend « cct » (Google Cloud
             Client Telemetry) et envoie des événements aux serveurs Google. Constaté sur appareil le
             24 octobre 2026, journal à l'appui : `TransportRuntime.CctTransportBackend: Status Code:
             200`. Cela contredit frontalement la promesse du README, « No cloud, no third-party app
             dependency », et le soin pris ailleurs à masquer les IP dans les journaux.

             Ce `meta-data` EST le registre des backends disponibles : il déclare que le backend
             nommé « cct » est fourni par cette fabrique. Le retirer fait que le runtime ne sait plus
             résoudre ce nom, et les événements sont abandonnés avant tout appel réseau.

             Pourquoi cette voie plutôt que les deux autres envisagées. Exclure la dépendance Gradle
             supprimerait des classes que MediaPipe référence : on troquerait un appel réseau contre
             un risque de `NoClassDefFoundError`, mauvais échange. Retirer les composants
             d'ordonnancement (`JobInfoSchedulerService`, `AlarmManagerSchedulerBroadcastReceiver`)
             exposerait à un `IllegalArgumentException: No such service` si du code tente encore de
             planifier un job. Couper l'enregistrement du backend se situe en amont des deux, sans
             rien retirer du classpath.

             À revérifier après toute montée de version de `tasks-vision` : si le nom du backend ou
             de la fabrique change, ce retrait deviendrait silencieusement inopérant. Le contrôle
             tient en une ligne, chercher `CctTransportBackend` dans le logcat, plus rien ne doit
             apparaître.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Sélecteur de langue en-app : persiste automatiquement la langue choisie via
             AppCompatDelegate.setApplicationLocales() sur TOUTES les versions d'Android (stockage
             propre à AppCompat sous API 33, délégué à LocaleManager au-delà), sans ce service, il
             faudrait réappliquer la langue nous-mêmes à chaque lancement (DataStore + appel manuel
             dans MainActivity.onCreate avant setContent). Ce service n'est jamais instancié
             (enabled=false), il ne sert qu'à déclarer la métadonnée que la bibliothèque AppCompat
             lit au démarrage.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
             Partage du fichier de logs (voir LoggingSettingsScreen) : un
             FileProvider permet de partager un fichier de stockage privé via une URI content://
             sans l'exposer directement (l'app en lecture destinataire du partage reçoit une
             permission ponctuelle, pas un accès large). Portée limitée à filesDir/logs/, voir
             res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
